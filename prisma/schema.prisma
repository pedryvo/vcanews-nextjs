generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Cidade {
  id    Int    @id @default(autoincrement())
  nome  String @unique
  blogs Blog[]
}

model Blog {
  id       Int        @id @default(autoincrement())
  nome     String
  rssUrl   String     @unique
  cidadeId Int
  cidade   Cidade     @relation(fields: [cidadeId], references: [id])
  posts    BlogPost[]
}

model BlogPost {
  id             Int      @id @default(autoincrement())
  titulo         String
  url            String   @unique
  imageUrl       String?
  dataPublicacao DateTime
  blogId         Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  blog           Blog     @relation(fields: [blogId], references: [id])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id               String               @id @default(cuid())
  name             String?
  email            String?              @unique
  emailVerified    DateTime?
  image            String?
  role             String               @default("USER")
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  bio              String?
  professionId     String?
  username         String?              @unique
  coverImage       String?
  birthDate        DateTime?
  isBlocked        Boolean              @default(false)
  accounts         Account[]
  comments         Comment[]
  denuncias        Denuncia[]
  reactions        Reaction[]
  sessions         Session[]
  profession       Profession?          @relation(fields: [professionId], references: [id])
  notifications    Notification[]
  sentBudgets      BudgetConversation[] @relation("SentBudgets")
  receivedBudgets  BudgetConversation[] @relation("ReceivedBudgets")
  blocksGiven      UserBlock[]          @relation("BlocksGiven")
  blocksReceived   UserBlock[]          @relation("BlocksReceived")
  portfolio        PortfolioImage[]
}

model PortfolioImage {
  id        String   @id @default(cuid())
  userId    String
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProfessionCategory {
  id          String       @id @default(cuid())
  name        String       @unique
  professions Profession[]
}

model Profession {
  id         String             @id @default(cuid())
  name       String             @unique
  categoryId String
  category   ProfessionCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  users      User[]
}

model Denuncia {
  id        String     @id @default(cuid())
  titulo    String
  descricao String
  aprovado  Boolean    @default(false)
  userId    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  imageUrl  String?
  comments  Comment[]
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  reactions Reaction[]
}

model Reaction {
  id         String   @id @default(cuid())
  userId     String
  denunciaId String
  type       String
  createdAt  DateTime @default(now())
  denuncia   Denuncia @relation(fields: [denunciaId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, denunciaId])
}

model Comment {
  id         String   @id @default(cuid())
  text       String
  userId     String
  denunciaId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  denuncia   Denuncia @relation(fields: [denunciaId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model SyncLog {
  id       Int      @id @default(1)
  lastSync DateTime @default(now())
  status   String   @default("SUCCESS")
}

model BudgetConversation {
  id             String    @id @default(cuid())
  senderId       String
  receiverId     String
  status         String    @default("OPEN") // "OPEN", "FINISHED"
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  lastMessageAt  DateTime?
  messages       Message[]
  sender         User      @relation("SentBudgets", fields: [senderId], references: [id])
  receiver       User      @relation("ReceivedBudgets", fields: [receiverId], references: [id])
}

model Message {
  id             String             @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  createdAt      DateTime           @default(now())
  conversation   BudgetConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  type        String   // "COMMENT", "BUDGET_MESSAGE"
  referenceId String   // ID da denúncia ou conversa
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("BlocksGiven", fields: [blockerId], references: [id])
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id])

  @@unique([blockerId, blockedId])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())
}
