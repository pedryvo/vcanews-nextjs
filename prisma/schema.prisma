generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Cidade {
  id    Int    @id @default(autoincrement())
  nome  String @unique
  blogs Blog[]
}

model Blog {
  id       Int        @id @default(autoincrement())
  nome     String
  rssUrl   String     @unique
  cidadeId Int
  cidade   Cidade     @relation(fields: [cidadeId], references: [id])
  posts    BlogPost[]
}

model BlogPost {
  id             Int      @id @default(autoincrement())
  titulo         String
  url            String   @unique
  imageUrl       String?
  dataPublicacao DateTime
  blogId         Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  blog           Blog     @relation(fields: [blogId], references: [id])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String      @id @default(cuid())
  name          String?
  email         String?     @unique
  emailVerified DateTime?
  image         String?
  role          String      @default("USER")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  bio           String?
  professionId  String?
  username      String?     @unique
  coverImage    String?
  accounts      Account[]
  comments      Comment[]
  denuncias     Denuncia[]
  reactions     Reaction[]
  sessions      Session[]
  profession    Profession? @relation(fields: [professionId], references: [id])
}

model ProfessionCategory {
  id          String       @id @default(cuid())
  name        String       @unique
  professions Profession[]
}

model Profession {
  id         String             @id @default(cuid())
  name       String             @unique
  categoryId String
  category   ProfessionCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  users      User[]
}

model Denuncia {
  id        String     @id @default(cuid())
  titulo    String
  descricao String
  aprovado  Boolean    @default(false)
  userId    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  imageUrl  String?
  comments  Comment[]
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  reactions Reaction[]
}

model Reaction {
  id         String   @id @default(cuid())
  userId     String
  denunciaId String
  type       String
  createdAt  DateTime @default(now())
  denuncia   Denuncia @relation(fields: [denunciaId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, denunciaId])
}

model Comment {
  id         String   @id @default(cuid())
  text       String
  userId     String
  denunciaId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  denuncia   Denuncia @relation(fields: [denunciaId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model SyncLog {
  id       Int      @id @default(1)
  lastSync DateTime @default(now())
  status   String   @default("SUCCESS")
}
